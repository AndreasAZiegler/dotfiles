# vim: filetype=neomuttrc
# muttrc file for account andreas@aaz.fyi
set realname = "Andreas Ziegler"
set from = "andreas@aaz.fyi"
set sendmail = "msmtp -a andreas@aaz.fyi"
alias me Andreas Ziegler <andreas@aaz.fyi>
set folder = "/data/.mail/andreas@aaz.fyi"
set header_cache = /home/andreasziegler/.cache/mutt-wizard/andreas@aaz.fyi/headers
set message_cachedir = /home/andreasziegler/.cache/mutt-wizard/andreas@aaz.fyi/bodies
set mbox_type = Maildir


bind index,pager gg noop
bind index,pager g noop
bind index,pager M noop
bind index,pager C noop
bind index gg first-entry
unmailboxes *
unalternates *
set signature = /home/andreasziegler/.config/mutt/accounts/andreas@aaz.fyi.signature
unmacro index o
macro index o "<shell-escape>mw -y andreas@aaz.fyi<enter>" "run mbsync to sync andreas@aaz.fyi"

mailboxes "=All Mail" "=Archive" "=Drafts" "=Folders/accounts" "=Folders/admin" "=Folders/family" "=Folders/jobsearch" "=Folders/newsletters" "=Folders/people" "=Folders/quaker" "=Folders/quaker/montmirail_2027" "=Folders/quaker/qcea" "=Folders/quaker/sym" "=Folders/quaker/zürich" "=Folders/receipts" "=Folders/research" "=Folders/support" "=Inbox" "=Labels/062.127@gmail.com" "=Sent" "=Spam" "=Starred" "=Trash"
macro index,pager gi "<change-folder>=Inbox<enter>" "go to inbox"
macro index,pager Mi ";<save-message>=Inbox<enter>" "move mail to inbox"
macro index,pager Ci ";<copy-message>=Inbox<enter>" "copy mail to inbox"
set spoolfile = "+Inbox"
set postponed = "+Drafts"
macro index,pager gd "<change-folder>=Drafts<enter>" "go to drafts"
macro index,pager Md ";<save-message>=Drafts<enter>" "move mail to drafts"
macro index,pager Cd ";<copy-message>=Drafts<enter>" "copy mail to drafts"
set record = "+Sent"
macro index,pager gs "<change-folder>=Sent<enter>" "go to sent"
macro index,pager Ms ";<save-message>=Sent<enter>" "move mail to sent"
macro index,pager Cs ";<copy-message>=Sent<enter>" "copy mail to sent"
macro index,pager gS "<change-folder>=Spam<enter>" "go to spam"
macro index,pager MS ";<save-message>=Spam<enter>" "move mail to spam"
macro index,pager CS ";<copy-message>=Spam<enter>" "copy mail to spam"
macro index,pager gt "<change-folder>=Trash<enter>" "go to trash"
macro index,pager Mt ";<save-message>=Trash<enter>" "move mail to trash"
macro index,pager Ct ";<copy-message>=Trash<enter>" "copy mail to trash"
set trash = "+Trash"