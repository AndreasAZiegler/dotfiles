# vim: filetype=neomuttrc
# muttrc file for account andreas.ziegler@robotics.utias.utoronto.ca
set realname = "andreas.ziegler"
set from = "andreas.ziegler@robotics.utias.utoronto.ca"
set sendmail = "msmtp -a andreas.ziegler@robotics.utias.utoronto.ca"
alias me andreas.ziegler <andreas.ziegler@robotics.utias.utoronto.ca>
set folder = "/home/andreasziegler/.local/share/mail/andreas.ziegler@robotics.utias.utoronto.ca"
set header_cache = /home/andreasziegler/.cache/mutt-wizard/andreas.ziegler@robotics.utias.utoronto.ca/headers
set message_cachedir = /home/andreasziegler/.cache/mutt-wizard/andreas.ziegler@robotics.utias.utoronto.ca/bodies
set mbox_type = Maildir
set hostname = "robotics.utias.utoronto.ca"
source /usr/share/mutt-wizard/switch.muttrc
set signature = /home/andreasziegler/.config/mutt/accounts/andreas.ziegler@robotics.utias.utoronto.ca.signature
set spoolfile = +INBOX
set postponed = +Drafts
set trash = +Trash
set record = +Sent

macro index o "<shell-escape>mw -y andreas.ziegler@robotics.utias.utoronto.ca<enter>" "run mbsync to sync andreas.ziegler@robotics.utias.utoronto.ca"
macro index \eg "<enter-command>unset wait_key<enter><shell-escape>gpg --list-secret-keys; printf 'Enter email ID of user to publish: '; read eID; printf 'Enter fingerprint of GPG key to publish: '; read eFGPT; /usr/libexec/gpg-wks-client --create \$eFGPT \$eID | msmtp --read-envelope-from --read-recipients -a andreas.ziegler@robotics.utias.utoronto.ca<enter>"  "publish GPG key to WKS provider"
macro index \eh "<pipe-message>/usr/libexec/gpg-wks-client --receive | msmtp --read-envelope-from --read-recipients -a andreas.ziegler@robotics.utias.utoronto.ca<enter>" "confirm GPG publication"

mailboxes "=INBOX" "=[Gmail]/All Mail" "=[Gmail]/Drafts" "=[Gmail]/Important" "=[Gmail]/Sent Mail" "=[Gmail]/Spam" "=[Gmail]/Starred" "=[Gmail]/Trash" "=collaborations" "=supervision" "=workshops/icra2027"
